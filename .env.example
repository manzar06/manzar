# Copy to .env and fill in. Never commit .env.

# Claude API key from platform.claude.com
ANTHROPIC_API_KEY=
# claude-opus-5-5 (best), claude-sonnet-5-5 (cheaper), claude-haiku-5-5 (cheapest)
IGBOT_MODEL=claude-opus-5-5
# low / medium / high
IGBOT_EFFORT=low

# Instagram (from your Meta developer app)
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_APP_SECRET=
# Any random string; enter the same one in the Meta webhook settings
IG_VERIFY_TOKEN=
GRAPH_API_HOST=https://graph.instagram.com
GRAPH_API_VERSION=v23.0

# true = decide and log, but post nothing. Set to false to go live.
DRY_RUN=true
MAX_REPLIES_PER_HOUR=60
BUSINESS_PROFILE_PATH=business_profile.md
DB_PATH=igbot.db
